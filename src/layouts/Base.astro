---
import '../styles/global.css';
import { SITE } from '../data/site';
import { href } from '../lib/util';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description = SITE.defaultDescription, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    {ldBlocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href('/')}>{SITE.name}</a>
        <nav aria-label="Main">
          <a href={href('/trades/')}>Trades</a>
          <a href={href('/software/')}>All software</a>
          <a href={href('/about/')}>Methodology</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{SITE.tagline}</p>
        <p class="muted">
          Facts are checked against vendor sites on the "last verified" date shown on each page. Prices change, so confirm with the vendor before you buy.
          We may add affiliate links in the future; they will never change a verdict. <a href={href('/about/')}>How we review</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
